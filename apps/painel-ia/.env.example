# Copie para .env (o .env não vai para o git).
# Pasta dos transcripts do Claude Code:
#   Linux/macOS: /home/<voce>/.claude/projects   Windows: C:/Users/<voce>/.claude/projects
CLAUDE_PROJECTS_DIR=

# Pasta dos transcripts do Antigravity (tempo real, sem precisar de API key):
#   Linux/macOS: /home/<voce>/.gemini/antigravity-cli/brain   Windows: C:/Users/<voce>/.gemini/antigravity-cli/brain
ANTIGRAVITY_BRAIN_DIR=

# Opcional: registro CSV e progresso de tarefas concluídas
REGISTRO_CSV=
PROGRESSO_MD=

# Opcional: cotas por Code Agent (tokens equivalentes) para o cálculo em % de sessão e semana
COTA_SESSAO_CLAUDE=10000000
COTA_SEMANA_CLAUDE=50000000
COTA_SESSAO_ANTIGRAVITY=10000000
COTA_SEMANA_ANTIGRAVITY=50000000
COTA_SESSAO_COPILOT=5000000
COTA_SEMANA_COPILOT=25000000

# Opcional: custo e uso real via Anthropic Admin API (somente conta Console/Organização)
ANTHROPIC_ADMIN_API_KEY=

# Opcional: aprovações do board do Monday
MONDAY_TOKEN=
MONDAY_BOARD_ID=

# Opcional: PRs abertos e métricas/billing do GitHub Copilot (o token só precisa de leitura)
GITHUB_REPO=MarcosRibeiroJesus/pos-engenharia-ia-aplicada-arquitetura
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_USER=
