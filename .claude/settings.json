{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sem_suposicoes.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/sem_suposicoes.py\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/memoria_compartilhada.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/memoria_compartilhada.py\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/memoria_compartilhada.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/memoria_compartilhada.py\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/memoria_compartilhada.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/memoria_compartilhada.py\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_entrega.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_entrega.py\"; fi",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_sdd.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_sdd.py\"; fi",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_delegacao.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_delegacao.py\"; fi",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_pergunta.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_pergunta.py\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_execucao.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_execucao.py\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/rtk_rewrite.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/rtk_rewrite.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/registrar_uso.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/registrar_uso.py\"; fi",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "hashicorp": {
      "source": {
        "source": "github",
        "repo": "hashicorp/agent-skills"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "promptfoo": {
      "source": {
        "source": "github",
        "repo": "promptfoo/promptfoo"
      }
    },
    "google-plugins": {
      "source": {
        "source": "github",
        "repo": "google/skills"
      }
    }
  },
  "enabledPlugins": {
    "terraform@hashicorp": true,
    "mcp-server-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "promptfoo@promptfoo": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "Bash(bash harness/init.sh)",
      "Bash(python3 harness/*)",
      "Bash(python3 -m unittest*)",
      "Bash(python3 -m pytest*)",
      "Bash(python3 plataforma/*)",
      "Bash(python3 scripts/*)",
      "Bash(python3 .github/ia/*)",
      "Bash(python harness/*)",
      "Bash(python -m unittest*)",
      "Bash(python -m pytest*)",
      "Bash(python plataforma/*)",
      "Bash(python scripts/*)",
      "Bash(python .github/ia/*)",
      "Bash(py harness/*)",
      "Bash(py -m unittest*)",
      "Bash(py -m pytest*)",
      "Bash(py plataforma/*)",
      "Bash(py scripts/*)",
      "Bash(py .github/ia/*)",
      "Bash(npm ci*)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(terraform init*)",
      "Bash(terraform validate*)",
      "Bash(terraform fmt*)",
      "Bash(terraform test*)",
      "Bash(terraform plan*)",
      "Bash(terraform show*)",
      "Bash(terraform providers*)",
      "Bash(terraform version*)",
      "Bash(terraform -chdir=*)",
      "Bash(tflint*)",
      "Bash(checkov*)",
      "Bash(zizmor*)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker pull *)",
      "Bash(floci *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch*)",
      "Bash(git worktree *)",
      "Bash(git rev-parse *)",
      "Bash(git restore *)",
      "Bash(git stash*)",
      "Bash(git push*)",
      "Bash(git ls-files*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view*)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(sort*)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(echo *)",
      "Bash(rtk git status*)",
      "Bash(rtk git diff*)",
      "Bash(rtk git log*)",
      "Bash(rtk git show*)",
      "Bash(rtk gain*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge*)",
      "Bash(gh api*)",
      "Bash(gh repo*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "WebFetch"
    ]
  }
}
